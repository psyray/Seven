{
	"name": "seven",
	"description": "A Discord bot for Hack The Box teams.",
	"version": "1.0.1",
	"main": "bot.js",
	"scripts": {
		"start": "node bot.js",
		"docker:build": "docker compose build",
		"docker:up": "docker compose up -d",
		"docker:down": "docker compose down",
		"docker:reset-db": "docker compose down -v",
		"docker:logs": "docker compose logs -f seven",
		"docker:restart": "docker compose restart seven",
		"test:intents": "node scripts/intent-smoke.js",
		"test:handler": "node scripts/handler-smoke.js",
		"test:charts": "node scripts/chart-smoke.js",
		"test:pusher": "node scripts/pusher-smoke.js",
		"test:sync": "node test/htb-sync-engine.test.js",
		"test:member-lab": "node test/member-lab-owns.test.js",
		"test:set-htb-tokens": "node test/set-htb-tokens.test.js",
		"test:htb-token-status": "node test/htb-token-status.test.js",
		"test:htb-token-truncate": "node test/htb-token-truncate.test.js",
		"test:team-activity": "node test/team-activity-fallback.test.js",
		"test:all": "npm run test:intents && npm run test:handler && npm run test:charts && npm run test:pusher && npm run test:sync && npm run test:member-lab && npm run test:set-htb-tokens && npm run test:htb-token-status && npm run test:team-activity",
		"test:e2e": "node scripts/e2e-help-audit.js",
		"test:logs": "node scripts/analyze-seven-logs.js",
		"doc:generate": "jsdoc -c jsdoc.config.json"
	},
	"engines": {
		"node": ">=20.x"
	},
	"dependencies": {
		"@google-cloud/dialogflow": "^3.5.0",
		"adm-zip": "^0.5.17",
		"archiver": "^5.3.0",
		"body-parser": "^1.19.1",
		"check-more-types": "^2.24.0",
		"cheerio": "^1.0.0-rc.10",
		"country-flag-emoji": "^1.0.3",
		"date-fns": "^2.28.0",
		"debug": "^4.3.3",
		"discord.js": "^12.5.3",
		"dotenv": "^8.6.0",
		"express": "^4.17.2",
		"express-http-proxy": "^1.6.3",
		"express-session": "^1.17.2",
		"highcharts": "^9.3.2",
		"jsdom": "^16.7.0",
		"lazy-ass": "^1.6.0",
		"memorystore": "^1.6.6",
		"nconf": "^0.10.0",
		"passport": "^0.6.0",
		"passport-discord": "^0.1.4",
		"pb-util": "^0.1.3",
		"pg-promise": "^10.11.1",
		"puppeteer": "^19.6.3",
		"pusher-client": "^1.1.0",
		"q": "^1.5.1",
		"serialize-javascript": "^6.0.0",
		"sharp": "^0.31.3",
		"superagent": "^5.3.1",
		"superagent-logger": "^1.1.0",
		"superagent-retry-delay": "^2.6.5",
		"superagent-throttle": "^1.0.1",
		"superdebug": "^2.2.0",
		"turndown": "^6.0.0",
		"uuid": "^8.3.2",
		"winston": "^3.19.0"
	},
	"devDependencies": {
		"bufferutil": "^4.0.6",
		"eslint": "^7.32.0",
		"jsdoc": "^4.0.5",
		"minami": "^1.2.3",
		"taffydb": "^2.7.3",
		"zombie": "^6.1.4"
	},
	"repository": "https://github.com/psyray/Seven"
}
