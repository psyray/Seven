# --- PostgreSQL (Docker Compose bundled) ---
POSTGRES_USER=seven
POSTGRES_PASSWORD=change_me_strong_password
POSTGRES_DB=seven
#
# IMPORTANT — password is set only on FIRST database init (empty volume).
# If you change POSTGRES_PASSWORD after the first "docker compose up", Postgres
# keeps the old password stored in volume seven_pgdata. The bot then fails with
# "password authentication failed for user seven".
#
# Fix: wipe the volume and start fresh (destroys all bot DB data):
#   npm run docker:reset-db && npm run docker:up
#
# Or change the password inside the running DB without wiping:
#   docker compose exec postgres psql -U seven -c "ALTER USER seven PASSWORD 'new_password';"
#   then set the same value in POSTGRES_PASSWORD here.
#
# Do not set DATABASE_URL in .env for Docker — compose injects PGHOST/PGUSER/PGPASSWORD.

# --- Discord ---
BOT_TOKEN=YOUR_DISCORD_DEVELOPER_BOT_CREDENTIAL
ADMIN_DISCORD_IDS=["673856718466029568"]
CAPTAIN_DISCORD_IDS=["673856718466029568"]
DISCORD_GUILD_ID=744689706153109545
DISCORD_ANNOUNCE_CHAN_ID=746262453642034474
EMOJI_GUILD_ID=744506234553109545

# --- Hack The Box (v4 API only) ---
# Generate on app.hackthebox.com → Profile → Settings → App Tokens
HTB_V4_TOKEN=your_fresh_v4_api_token_from_app_hackthebox_com
HTB_API_BASE=https://labs.hackthebox.com/api/v4
HTB_APP_BASE=https://app.hackthebox.com
HTB_TEAM_ID=21024
FOUNDER_HTB_ID=

# --- Google Dialogflow ---
GOOGLE_APPLICATION_CREDENTIALS={"type":"service_account","project_id":"..."}
GOOGLE_CLOUD_PROJECT=your_project_tag

# --- Logging (Docker paths) ---
LOG_DIR=/var/log/sevenbot
LOG_LEVEL=info
# Progress log every N items during bulk HTB fetches (machines, challenges, members)
HTB_LOG_PROGRESS_EVERY=25
# Set true to log every individual HTB API GET (very verbose)
# HTB_API_LOG_REQUESTS=true

# --- Optional API server (expose port 666 in compose if enabled) ---
# API_SERVER_ENABLED=true
# API_SERVER_PORT=666
# API_SERVER_URL=https://your-public-url.example.com
# API_SERVER_DISCORD_CLIENT_SECRET=
# API_SERVER_DISCORD_CLIENT_ID=
